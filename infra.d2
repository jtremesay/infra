direction: down

internet: 🌐 Internet {
  shape: cloud
  style.fill: "#eeeeee"
}

m_sway: Sway (Hetzner Storage Box) {
  shape: cloud
  style.fill: "#eeeeee"
}

m_hiraeth: Hiraeth (NixOS) {
  cn_caddy: Caddy (nspawn) {
    s_caddy: Caddy {
      shape: oval
    }
  }

  cn_alix: Alix (nspawn) {
    s_pg: PostgreSQL {
      shape: cylinder
    }

    podman: Podman {
      co_alix_web: Camille Web (OCI) {
        shape: parallelogram
      }

      co_alix_mattermost: Camille Mattermost (OCI) {
        shape: parallelogram
      }
    }
  }

  cn_freshrs: Freshrs (nspawn) {
    s_pg: PostgreSQL {
      shape: cylinder
    }

    s_freshrs: Freshrs {
      shape: oval
    }
  }

  cn_headscale: Headscale (nspawn) {
    s_headscale: Headscale {
      shape: oval
    }
  }

  cn_mattermost: Mattermost (nspawn) {
    s_mattermost: Mattermost {
      shape: oval
    }

    s_pg: PostgreSQL {
      shape: cylinder
    }
  }

  cn_mirrors: Mirrors (nspawn) {
    s_caddy: Caddy {
      shape: oval
    }

    d_archlinux: Arch Linux {
      shape: package
    }
  }

  cn_nextcloud: Nextcloud (nspawn) {
    s_pg: PostgreSQL {
      shape: cylinder
    }

    s_nextcloud: Nextcloud {
      shape: oval
    }
  }

  cn_rssbridge: RSSBridge (nspawn) {
    s_rssbridge: RSSBridge {
      shape: oval
    }
  }

  cn_vaultwarden: Vaultwarden (nspawn) {
    s_vaultwarden: Vaultwarden {
      shape: oval
    }
  }

  s_borgmatic: Borgmatic {
    shape: oval
  }
}

ovh: OVH DNS {
  shape: cloud
  style.fill: "#eeeeee"
}

internet -> m_hiraeth.cn_caddy.s_caddy
m_hiraeth.cn_caddy.s_caddy -> ovh: DNS-01 certificates
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_alix.podman.co_alix_web: alix.jtremesay.eu
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_freshrs.s_freshrs: rss.jtremesay.eu
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_headscale.s_headscale: headscale.jtremesay.eu
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_mattermost.s_mattermost: mattermost.jtremesay.eu
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_mirrors.s_caddy: mirrors.jtremesay.eu
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_nextcloud.s_nextcloud: cloud.jtremesay.eu
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_rssbridge.s_rssbridge: rss.jtremesay.eu
m_hiraeth.cn_caddy.s_caddy -> m_hiraeth.cn_vaultwarden.s_vaultwarden: vault.jtremesay.eu

m_hiraeth.cn_alix.podman.co_alix_web -> m_hiraeth.cn_alix.s_pg
m_hiraeth.cn_alix.podman.co_alix_mattermost -> m_hiraeth.cn_alix.s_pg
m_hiraeth.cn_alix.podman.co_alix_mattermost -> m_hiraeth.cn_mattermost.s_mattermost

m_hiraeth.cn_freshrs.s_freshrs -> m_hiraeth.cn_freshrs.s_pg
m_hiraeth.cn_mirrors.s_caddy -> m_hiraeth.cn_mirrors.d_archlinux
m_hiraeth.cn_mattermost.s_mattermost -> m_hiraeth.cn_mattermost.s_pg
m_hiraeth.cn_nextcloud.s_nextcloud -> m_hiraeth.cn_nextcloud.s_pg

m_hiraeth.cn_freshrs -> m_hiraeth.s_borgmatic
m_hiraeth.cn_mattermost -> m_hiraeth.s_borgmatic
m_hiraeth.cn_nextcloud -> m_hiraeth.s_borgmatic
m_hiraeth.cn_vaultwarden -> m_hiraeth.s_borgmatic

m_hiraeth.s_borgmatic -> m_sway
