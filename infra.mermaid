graph TB
    Internet["🌐 Internet"]

    subgraph hiraeth["hiraeth (NixOS)"]
        Caddy["Caddy"]

        subgraph mod_web_freshrss["container"]
            FreshRSS["FreshRSS"]
            FreshRSS_PG[("PostgreSQL")]
            FreshRSS --> FreshRSS_PG
        end

        subgraph mod_web_rssbridge["container"]
            RSSBridge["RSS-Bridge"]
        end

        subgraph mod_web_vaultwarden["container"]
            Vaultwarden["Vaultwarden"]
        end

        subgraph mod_web_nextcloud["container"]
            Nextcloud["Nextcloud"]
            Nextcloud_PG[("PostgreSQL")]
            Nextcloud --> Nextcloud_PG
        end

        subgraph mod_web_mattermost["container"]
            Mattermost["Mattermost"]
            Mattermost_PG[("PostgreSQL")]
            Mattermost --> Mattermost_PG
        end
        
        subgraph mod_web_matrix["container"]
            Matrix["Matrix"]
            Matrix_PG[("PostgreSQL")]
            Matrix --> Matrix_PG
        end

        subgraph mod_net_headscale["container"]
            Headscale["Headscale"]
        end

        PublicHTML["/srv/http/public_html"]
        Mirrors["/srv/http/mirrors"]

        subgraph mod_swarm["Docker Swarm"]
            Traefik["Traefik"]
            JtremesayOrg["jtremesay.eu"]
            CamilleOrg["camille.jtremesay.eu"]
            Traefik --> JtremesayOrg
            Traefik --> CamilleOrg
        end

        Borgmatic["Borgmatic"]
    end

    Sway["Hetzner Storage Box"]

    Internet --> Caddy

    Caddy -->|"rss.jtremesay.eu"| FreshRSS
    Caddy -->|"rssbridge.jtremesay.eu"| RSSBridge
    Caddy -->|"vault.jtremesay.eu"| Vaultwarden
    Caddy -->|"cloud.jtremesay.eu"| Nextcloud
    Caddy -->|"mattermost.jtremesay.eu"| Mattermost
    Caddy -->|"matrix.jtremesay.eu"| Matrix
    Caddy -->|"headscale.jtremesay.eu"| Headscale
    Caddy -->|"users.jtremesay.eu"| PublicHTML
    Caddy -->|"mirrors.jtremesay.eu"| Mirrors
    Caddy -->|"*.jtremesay.eu (swarm)"| Traefik

    mod_web_freshrss -.->|"backup"| Borgmatic 
    mod_web_nextcloud -.->|"backup"| Borgmatic 
    mod_web_mattermost -.->|"backup"| Borgmatic 
    mod_web_matrix -.->|"backup"| Borgmatic
    mod_web_vaultwarden -.->|"backup"| Borgmatic 
    mod_swarm -.->|"backup"| Borgmatic

    Borgmatic -.->|"backup"| Sway